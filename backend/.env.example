# AgroSense server environment variables.
# Copy this file to `.env` (never commit the real one) and fill in your values.

# --- Core (required) ---------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=agrosense

# Gemini API key for disease detection (called server-side only, never from the browser).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Allowed browser origin(s) for CORS. Use your deployed frontend URL in production,
# e.g. https://agrosense.lovable.app (comma-separate to allow more than one, e.g. to also
# allow a custom domain once you connect one in Lovable).
FRONTEND_URL=http://localhost:5173

# --- Optional — leave blank to disable that feature ---------------------------
# Razorpay (Pro upgrade / payments). Needs BOTH values. While either is blank, the free-scan
# limit is switched off and every user gets unlimited disease detection.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# data.gov.in API key for live mandi (market) prices. While blank, /api/mandi-price
# responds with "Price data unavailable" instead of erroring.
DATA_GOV_IN_API_KEY=
